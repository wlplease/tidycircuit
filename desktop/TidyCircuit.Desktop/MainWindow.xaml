<Window x:Class="TidyCircuit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TidyCircuit 0.2.0-rc.1 · UNSIGNED CANDIDATE" Height="850" Width="1360" MinHeight="740" MinWidth="1120"
        Background="#F3F8F6" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#143E50"/>
        <SolidColorBrush x:Key="Lagoon" Color="#087D86"/>
        <SolidColorBrush x:Key="SeaGlass" Color="#E7F5F2"/>
        <SolidColorBrush x:Key="Muted" Color="#688086"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#45616A"/><Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="13,12"/>
        </Style>
        <Style x:Key="QuickCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#143E50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AlternatingRowBackground" Value="#F7FAF8"/>
            <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFEFC" BorderBrush="#DCE9E6" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,38">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#143E50">
                            <TextBlock Text="≋" Foreground="#7EE0D1" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="TidyCircuit" Foreground="#143E50" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="PRIVATE PC REVIEW" Foreground="#829498" FontSize="8" FontWeight="Bold" Margin="1,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#829498" FontSize="9" FontWeight="Bold" Margin="5,0,0,8"/>
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" Content="▦   Overview" Tag="0" Background="#DDF4EF" Foreground="#087D86" Click="Navigate_Click"/>
                    <Button x:Name="SmartFindNavButton" Style="{StaticResource NavButton}" Content="⌕   Smart find" Tag="1" Click="Navigate_Click"/>
                    <Button x:Name="ReviewFilesNavButton" Style="{StaticResource NavButton}" Content="▤   Review files" Tag="2" Click="Navigate_Click"/>
                    <Button x:Name="GuideNavButton" Style="{StaticResource NavButton}" Content="✦   Guide chat" Tag="3" Click="Navigate_Click"/>
                    <TextBlock Text="WINDOWS TOOLS" Foreground="#829498" FontSize="9" FontWeight="Bold" Margin="5,24,0,8"/>
                    <Button x:Name="SystemNavButton" Style="{StaticResource NavButton}" Content="◉   System details" Tag="4" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="◇   Windows Security" Click="Safety_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,3">
                    <Border Background="#E8F5F1" CornerRadius="12" Padding="12"><StackPanel>
                        <TextBlock Text="ON THIS PC" Foreground="#087D86" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="Your scan stays private. You decide what changes." TextWrapping="Wrap" Foreground="#527078" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="0.2.0-RC.1 · UNSIGNED TEST BUILD" Foreground="#8EA1A0" FontSize="8" Margin="2,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="YOUR PC, IN CLEAR VIEW" Foreground="#087D86" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Text="Find what matters." FontSize="30" FontWeight="SemiBold" Foreground="#143E50" Margin="0,5,0,0"/>
                    <TextBlock x:Name="SelectedRootText" Text="No folder selected · scans stay within the folder you choose" Foreground="#647C82" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="FolderButton" Content="Choose a folder" Background="#087D86" Foreground="White" Padding="18,12" Click="ChooseFolder_Click"/>
                    <Button x:Name="FindCachesButton" Content="Find temporary files" ToolTip="Find recognized browser caches and older temporary files in common locations" Background="#E7F5F2" Foreground="#087D86" Padding="18,9" Margin="0,7,0,0" Click="FindCaches_Click"/>
                    <Button x:Name="ScanButton" Content="Scan again" Background="#DDF4EF" Foreground="#087D86" Padding="18,9" Margin="0,7,0,0" Click="ScanAgain_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#E7F5F2" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Ready · Choose a folder to begin" TextTrimming="CharacterEllipsis" Foreground="#245D62" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="ScanProgress" Grid.Column="1" Width="120" Height="5" IsIndeterminate="False" Visibility="Collapsed" Foreground="#087D86" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock x:Name="ProgressText" Grid.Column="2" Foreground="#638287" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button x:Name="PauseScanButton" Grid.Column="3" Content="Pause" IsEnabled="False" Visibility="Collapsed" Background="Transparent" Foreground="#087D86" Padding="8,4" Margin="8,0,0,0" Click="PauseScan_Click"/>
                        <Button x:Name="CancelScanButton" Grid.Column="4" Content="Cancel" IsEnabled="False" Visibility="Collapsed" Background="Transparent" Foreground="#9B4D3B" Padding="8,4" Margin="4,0,0,0" Click="CancelScan_Click"/>
                    </Grid>
                    <Grid x:Name="SearchProgressRow" Grid.Row="1" Visibility="Collapsed" Margin="1,7,1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="SearchProgressBar" Height="4" Minimum="0" Maximum="100" Foreground="#087D86" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchProgressText" Grid.Column="1" Text="Searching…" Foreground="#638287" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/>
                        <Button x:Name="SearchPauseButton" Grid.Column="2" Content="Pause" Background="Transparent" Foreground="#087D86" Padding="8,3" Margin="5,0,0,0" Click="PauseSearch_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#688086"/><Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,5,10"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#DDF4EF"/><Setter Property="Foreground" Value="#087D86"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EAF4F1"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Overview">
                    <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0"><StackPanel>
                                <TextBlock Text="FILES FOUND" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="FileCountText" Text="—" Foreground="#143E50" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel></Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="4,0"><StackPanel>
                                <TextBlock Text="SPACE REVIEWED" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="FolderSizeText" Text="Choose a folder" Foreground="#143E50" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel></Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="4,0"><StackPanel>
                                <TextBlock Text="EXTRA COPIES" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="DuplicatesText" Text="—" Foreground="#143E50" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel></Border>
                            <Border Background="White" CornerRadius="12" Padding="16" Margin="8,0,0,0"><StackPanel>
                                <TextBlock Text="SELECTED" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="OverviewMarkedText" Text="0" Foreground="#143E50" FontSize="24" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            </StackPanel></Border>
                        </UniformGrid>
                        <StackPanel Grid.Row="1" Margin="2,0,0,10">
                            <TextBlock Text="Start with a useful view" Foreground="#143E50" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Pick a folder or find temporary files in common locations. Review every result before cleanup." Foreground="#688086" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <UniformGrid Grid.Row="2" Columns="2" Rows="2" VerticalAlignment="Top">
                            <Button Style="{StaticResource QuickCard}" Tag="largest files" Click="QuickQuery_Click"><StackPanel>
                                <TextBlock Text="Largest files" FontSize="16" FontWeight="Bold"/><TextBlock Text="See the 25 biggest files in this scan." Foreground="#688086" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel></Button>
                            <Button Style="{StaticResource QuickCard}" Tag="duplicates" Click="QuickQuery_Click"><StackPanel>
                                <TextBlock Text="Duplicate content" FontSize="16" FontWeight="Bold"/><TextBlock Text="Compare matching file sizes with local SHA-256 hashes." Foreground="#688086" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel></Button>
                            <Button Style="{StaticResource QuickCard}" Tag="old files" Click="QuickQuery_Click"><StackPanel>
                                <TextBlock Text="Older files" FontSize="16" FontWeight="Bold"/><TextBlock Text="Review files unchanged for about six months or longer." Foreground="#688086" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel></Button>
                            <Button Style="{StaticResource QuickCard}" Tag="photos" Click="QuickQuery_Click"><StackPanel>
                                <TextBlock Text="Browse by type" FontSize="16" FontWeight="Bold"/><TextBlock Text="Find photos, videos, documents, audio, and archives." Foreground="#688086" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel></Button>
                        </UniformGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Smart find">
                    <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E7F5F2" BorderBrush="#CFE9E3" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="SEARCH THIS SCAN" Foreground="#143E50" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="On-device rules · no model or network" DockPanel.Dock="Right" Foreground="#638287" FontSize="10"/>
                                </DockPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="AskBox" Height="44" Padding="12,10" BorderBrush="#D1E4DF" FontSize="14"
                                             Text="Try: largest videos, duplicates, old files, or PDFs" Foreground="#829498" GotKeyboardFocus="AskBox_GotKeyboardFocus" LostKeyboardFocus="AskBox_LostKeyboardFocus" KeyDown="AskBox_KeyDown"/>
                                    <Button Grid.Column="1" Content="Find files" Background="#143E50" Foreground="White" Margin="9,0,0,0" Padding="18,10" Click="Ask_Click"/>
                                </Grid>
                                <WrapPanel Margin="0,11,0,0">
                                    <Button Content="Largest files" Tag="largest files" Padding="10,7" Margin="0,0,7,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                                    <Button Content="Duplicates" Tag="duplicates" Padding="10,7" Margin="0,0,7,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                                    <Button Content="Older than 6 months" Tag="old files" Padding="10,7" Margin="0,0,7,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                                    <Button Content="Photos" Tag="photos" Padding="10,7" Margin="0,0,7,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                                    <Button Content="Videos" Tag="videos" Padding="10,7" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                                    <Button Content="Browser cache" Tag="browser cache" Padding="10,7" Margin="7,0,0,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel><TextBlock Text="WHAT I FOUND" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="AssistantStatus" Text="Choose a folder first. Questions search file names, dates, sizes, types, and duplicate matches in that scan." Foreground="#143E50" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="#FFFEFC" BorderBrush="#DCE9E6" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                            <StackPanel><TextBlock Text="SUPPORTED QUESTIONS" Foreground="#143E50" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="Duplicates · largest files · older files · browser cache · photos · videos · documents · audio · archives · Downloads · Desktop · file extensions such as .pdf" Foreground="#688086" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Browser cache means recognized Chrome, Edge, Brave, and Firefox temporary cache files only. Review and select manually; cookies, history, passwords, and bookmarks are never included." Foreground="#688086" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="Verified duplicate groups label one keep candidate and the exact extra copies. Nothing is selected automatically." Foreground="#688086" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="Suggestions are clues, not safety verdicts. Nothing is selected automatically." Foreground="#9B4D3B" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Row="3" Content="Review matching files  →" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#087D86" Foreground="White" Padding="17,11" Click="ReviewMatches_Click"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Review files">
                    <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="FILE REVIEW" Foreground="#143E50" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Click a column title to sort. Review the full path and file details before cleanup." Foreground="#688086" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ReviewCountText" Grid.Column="1" Text="0 shown · 0 selected" Foreground="#087D86" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Height="36" Padding="10,8" BorderBrush="#D6E6E5" ToolTip="Search file names, folders, extensions, or any part of a path" Text="Search names, folders, extensions…" Foreground="#829498" GotKeyboardFocus="SearchBox_GotKeyboardFocus" LostKeyboardFocus="SearchBox_LostKeyboardFocus" TextChanged="SearchBox_TextChanged"/>
                                    <ComboBox x:Name="SortBox" Grid.Column="1" Width="146" Height="36" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged"><ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Oldest first"/></ComboBox>
                                    <ComboBox x:Name="ViewFilterBox" Grid.Column="2" Width="145" Height="36" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="ViewFilterBox_SelectionChanged"><ComboBoxItem Content="All files"/><ComboBoxItem Content="Large · 100 MB+"/><ComboBoxItem Content="Older · 6 months+"/><ComboBoxItem Content="Duplicates · verified"/><ComboBoxItem Content="Same-size candidates"/><ComboBoxItem Content="Temporary files"/></ComboBox>
                                    <ComboBox x:Name="FolderFilterBox" Grid.Column="3" Width="150" Height="36" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="FolderFilterBox_SelectionChanged"><ComboBoxItem Content="All folders"/></ComboBox>
                                    <Button x:Name="SelectAllButton" Grid.Column="4" Content="Select all shown" Background="#E7F5F2" Foreground="#087D86" Margin="8,0,0,0" Click="SelectAll_Click"/>
                                    <Button x:Name="ClearSelectionButton" Grid.Column="5" Content="Clear selection" Background="Transparent" Foreground="#45616A" Margin="3,0,0,0" Click="ClearMarks_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Selection covers only the current filtered results. Every move is checked and confirmed." Foreground="#829498" FontSize="10" VerticalAlignment="Center"/>
                                    <Button x:Name="SelectVisibleExtrasButton" IsEnabled="False" Grid.Column="1" Content="Select visible extras" ToolTip="Select only verified extra copies shown in this view; nothing is moved" Background="#FFF4E9" Foreground="#8B5D32" Padding="12,8" Margin="0,0,7,0" Click="SelectVisibleExtras_Click"/>
                                    <Button x:Name="VerifyDuplicatesButton" IsEnabled="False" Grid.Column="2" Content="Verify same-size" Background="#E7F5F2" Foreground="#087D86" Padding="12,8" Margin="0,0,7,0" Click="VerifyDuplicates_Click"/>
                                    <Button x:Name="UndoOrganizationButton" IsEnabled="False" Grid.Column="3" Content="Undo organize" Background="Transparent" Foreground="#45616A" Padding="10,8" Margin="0,0,7,0" Click="UndoOrganization_Click"/>
                                    <Button Grid.Column="4" Content="Organize preview" Background="#FFF4E9" Foreground="#8B5D32" Padding="13,8" Margin="0,0,7,0" Click="OrganizePreview_Click"/>
                                    <Button Grid.Column="5" Content="Export selected" Background="#143E50" Foreground="White" Padding="13,8" Margin="0,0,7,0" Click="Export_Click"/>
                                    <Button x:Name="RecycleButton" IsEnabled="False" Grid.Column="6" Content="Move to Recycle Bin" Background="#FBECE7" Foreground="#9B4D3B" Padding="13,8" Click="RecycleMarked_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Background="White" CornerRadius="13" Padding="9">
                            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" AlternationCount="2" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="SELECT" Binding="{Binding Marked, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="FILE NAME" SortMemberPath="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="FULL PATH" SortMemberPath="FullPath" Binding="{Binding FullPath}" Width="3*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding FullPath}"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="TYPE" SortMemberPath="Type" Binding="{Binding TypeDisplay}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="SIZE" SortMemberPath="Size" Binding="{Binding SizeDisplay}" Width="95" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="AGE" SortMemberPath="AgeDays" Binding="{Binding AgeDisplay}" Width="75" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="COPY ROLE" SortMemberPath="DuplicateSort" Binding="{Binding DuplicateDisplay}" Width="170" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="MODIFIED" SortMemberPath="Modified" Binding="{Binding ModifiedDisplay}" Width="135" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Guide chat">
                    <Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="#E7F5F2" CornerRadius="13" Padding="20" Margin="0,0,0,12"><StackPanel>
                            <TextBlock Text="TIDYCIRCUIT GUIDE" Foreground="#087D86" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Ask about your cleanup." Foreground="#143E50" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="Built-in answers · remembers this conversation until you close the app · no cloud AI" Foreground="#688086" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel></Border>
                        <Border Grid.Row="1" Background="White" CornerRadius="13" Padding="12">
                            <ListBox x:Name="ChatMessagesList" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate><DataTemplate><Border Background="{Binding BubbleBrush}" CornerRadius="12" Padding="13" Margin="4,3" MaxWidth="680" HorizontalAlignment="{Binding Alignment}"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding TextBrush}" FontSize="13"/></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <WrapPanel Grid.Row="2" Margin="0,10,0,7">
                            <Button Content="What can it clean?" Tag="What can it clean?" Background="White" Foreground="#087D86" Margin="0,0,7,0" Click="ChatSuggestion_Click"/>
