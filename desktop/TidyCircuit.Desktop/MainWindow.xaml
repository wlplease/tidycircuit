                            <Border Background="White" CornerRadius="12" Padding="18" Margin="4,0,4,7"><StackPanel><TextBlock Text="BATTERY" Foreground="#829498" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="BatteryStatusText" Text="Refresh to read" Foreground="#143E50" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="BatteryDetailText" Foreground="#688086" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="12" Padding="18" Margin="7,0,0,7"><StackPanel><TextBlock Text="STORAGE" Foreground="#829498" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="StorageStatusText" Text="Refresh to read" Foreground="#143E50" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="StorageDetailText" Foreground="#688086" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="Malware protection" Foreground="#143E50" FontSize="16" FontWeight="Bold" Margin="2,8,0,6"/>
                        <Border Background="White" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="TidyCircuit does not scan for or diagnose malware. Use Windows Security / Microsoft Defender for threat protection." Foreground="#45616A" FontSize="12" TextWrapping="Wrap"/><Button Content="Open Windows Security" HorizontalAlignment="Left" Background="#143E50" Foreground="White" Margin="0,10,0,0" Click="Safety_Click"/></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="3" Text="Unsigned candidate · local review · no uploads · Recycle Bin only" Foreground="#829498" FontSize="10" Margin="3,9,0,0"/>
