<Window x:Class="TidyCircuit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TidyCircuit" Height="820" Width="1280" MinHeight="680" MinWidth="980" Background="#F3F8F6" WindowStartupLocation="CenterScreen"><Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="39"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AlternatingRowBackground" Value="#F7FAF8"/></Style></Window.Resources><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#FFFEFC" BorderBrush="#DCE9E6" BorderThickness="0,0,1,0"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,5,0,45"><Border Width="38" Height="38" CornerRadius="12" Background="#143E50"><TextBlock Text="≋" Foreground="#7EE0D1" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="TidyCircuit" Foreground="#143E50" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0"/></StackPanel><TextBlock Text="YOUR PC" Foreground="#789095" FontSize="10" FontWeight="Bold" Margin="5,0,0,12"/><Button x:Name="ScanButton" Content="⌕   Analyze files" Background="#DDF4EF" Foreground="#087D86" HorizontalContentAlignment="Left" Click="ChooseFolder_Click"/><Button Content="▤   System details" Background="Transparent" Foreground="#45616A" HorizontalContentAlignment="Left" Click="System_Click"/><Button Content="✦   Safety &amp; cleanup" Background="Transparent" Foreground="#45616A" HorizontalContentAlignment="Left" Click="Safety_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5"><Border Background="#E8F5F1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="PRIVATE BY DESIGN" Foreground="#087D86" FontSize="9" FontWeight="Bold"/><TextBlock Text="Your scan stays on this PC." TextWrapping="Wrap" Foreground="#527078" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="TIDYCIRCUIT · FREE EDITION" Foreground="#8EA1A0" FontSize="9" Margin="2,14,0,0"/></StackPanel></DockPanel></Border><Grid Grid.Column="1" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR PC, IN CLEAR VIEW" Foreground="#087D86" FontWeight="Bold" FontSize="10"/><TextBlock Text="A healthier PC, on your terms." FontSize="32" FontWeight="SemiBold" Foreground="#143E50" Margin="0,7,0,0"/><TextBlock Text="Choose a folder. See what’s inside. Decide what happens." Foreground="#647C82" FontSize="14" Margin="0,4,0,0"/></StackPanel><Button x:Name="FolderButton" Grid.Column="1" Content="Choose a folder  ↗" Background="#087D86" Foreground="White" VerticalAlignment="Center" Click="ChooseFolder_Click"/></Grid><UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16"><Border Background="White" CornerRadius="12" Padding="17" Margin="0,0,10,0"><StackPanel><TextBlock Text="FILES REVIEWED" Foreground="#829498" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="FileCountText" Text="—" Foreground="#143E50" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="12" Padding="17" Margin="5,0"><StackPanel><TextBlock Text="FOLDER SIZE" Foreground="#829498" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="FolderSizeText" Text="Choose a folder" Foreground="#143E50" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="12" Padding="17" Margin="10,0,0,0"><StackPanel><TextBlock Text="MATCHED CONTENTS" Foreground="#829498" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="DuplicatesText" Text="—" Foreground="#143E50" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Background="#E7F5F2" CornerRadius="10" Padding="12" Margin="0,0,0,14"><StackPanel><DockPanel><TextBlock x:Name="StatusText" Text="Ready · Select a folder to begin" Foreground="#245D62" FontWeight="SemiBold"/><TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Foreground="#638287"/></DockPanel><ProgressBar x:Name="ScanProgress" Height="4" Margin="0,9,0,0" Foreground="#F37E69" Background="#C8E8E1" IsIndeterminate="False"/></StackPanel></Border><Border Grid.Row="3" Background="White" CornerRadius="14" Padding="15"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="FILE REVIEW" Foreground="#143E50" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Width="220" Margin="12,0,0,0" Padding="9" BorderBrush="#D6E6E5" TextChanged="SearchBox_TextChanged"/><ComboBox x:Name="SortBox" Width="140" Margin="9,0,0,0" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged"><ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Oldest first"/></ComboBox><Button Content="Export marked" Background="#143E50" Foreground="White" Margin="9,0,0,0" Click="Export_Click"/></StackPanel><DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.Columns><DataGridCheckBoxColumn Header="REVIEW" Binding="{Binding Marked, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="LOCATION" Binding="{Binding RelativePath}" Width="3*" IsReadOnly="True"/><DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="MODIFIED" Binding="{Binding ModifiedDisplay}" Width="145" IsReadOnly="True"/></DataGrid.Columns></DataGrid></DockPanel></Border><TextBlock Grid.Row="4" Text="Read-only scan · Content hashes stay local · No files moved or deleted" Foreground="#829498" FontSize="10" Margin="3,12,0,0"/></Grid></Grid></Window>

