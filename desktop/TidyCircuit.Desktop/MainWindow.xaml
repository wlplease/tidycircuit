                            <Button Grid.Column="1" Content="Send" Background="#087D86" Foreground="White" Margin="9,0,0,0" Padding="20,10" Click="ChatSend_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="System details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,8,8,20">
                        <Border Background="#E7F5F2" CornerRadius="14" Padding="22" Margin="0,0,0,14"><StackPanel>
                            <TextBlock Text="READ-ONLY WINDOWS SNAPSHOT" Foreground="#087D86" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Your PC at a glance" Foreground="#143E50" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
