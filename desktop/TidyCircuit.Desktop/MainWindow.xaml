<Window x:Class="TidyCircuit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TidyCircuit" Height="850" Width="1320" MinHeight="740" MinWidth="1040"
        Background="#F3F8F6" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="39"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AlternatingRowBackground" Value="#F7FAF8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#FFFEFC" BorderBrush="#DCE9E6" BorderThickness="0,0,1,0">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,45">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#143E50">
                            <TextBlock Text="≋" Foreground="#7EE0D1" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TidyCircuit" Foreground="#143E50" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0"/>
                    </StackPanel>
                    <TextBlock Text="YOUR PC" Foreground="#789095" FontSize="10" FontWeight="Bold" Margin="5,0,0,12"/>
                    <Button x:Name="ScanButton" Content="⌕   Analyze files" Background="#DDF4EF" Foreground="#087D86" HorizontalContentAlignment="Left" Click="ChooseFolder_Click"/>
                    <Button Content="▤   System details" Background="Transparent" Foreground="#45616A" HorizontalContentAlignment="Left" Click="System_Click"/>
                    <Button Content="✦   Safety &amp; cleanup" Background="Transparent" Foreground="#45616A" HorizontalContentAlignment="Left" Click="Safety_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
                    <Border Background="#E8F5F1" CornerRadius="12" Padding="12"><StackPanel>
                        <TextBlock Text="PRIVATE BY DESIGN" Foreground="#087D86" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="Your scan stays on this PC." TextWrapping="Wrap" Foreground="#527078" Margin="0,5,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="TIDYCIRCUIT · FREE EDITION" Foreground="#8EA1A0" FontSize="9" Margin="2,14,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="YOUR PC, IN CLEAR VIEW" Foreground="#087D86" FontWeight="Bold" FontSize="10"/>
                    <TextBlock Text="Find what matters." FontSize="31" FontWeight="SemiBold" Foreground="#143E50" Margin="0,6,0,0"/>
                    <TextBlock Text="Private file insights. You choose every change." Foreground="#647C82" FontSize="14" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="FolderButton" Grid.Column="1" Content="Choose a folder  ↗" Background="#087D86" Foreground="White" VerticalAlignment="Center" Click="ChooseFolder_Click"/>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,9,0"><StackPanel>
                    <TextBlock Text="FILES FOUND" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="FileCountText" Text="—" Foreground="#143E50" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel></Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="5,0"><StackPanel>
                    <TextBlock Text="FOLDER SIZE" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="FolderSizeText" Text="Choose a folder" Foreground="#143E50" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel></Border>
                <Border Background="White" CornerRadius="12" Padding="16" Margin="9,0,0,0"><StackPanel>
                    <TextBlock Text="EXTRA COPIES" Foreground="#829498" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="DuplicatesText" Text="—" Foreground="#143E50" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="2" Background="#E7F5F2" BorderBrush="#CFE9E3" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="LOCAL SMART FINDER" Foreground="#143E50" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="On-device rules · no model or network" DockPanel.Dock="Right" Foreground="#638287" FontSize="10"/>
                    </DockPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="AskBox" Height="38" Padding="10,8" BorderBrush="#D1E4DF" FontSize="13"
                                 Text="Try: largest videos, duplicates, old files, or PDFs" Foreground="#829498" GotKeyboardFocus="AskBox_GotKeyboardFocus" LostKeyboardFocus="AskBox_LostKeyboardFocus" KeyDown="AskBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Find" Background="#143E50" Foreground="White" Margin="8,0,0,0" Click="Ask_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Largest files" Tag="largest files" Padding="10,6" Margin="0,0,6,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                        <Button Content="Duplicates" Tag="duplicates" Padding="10,6" Margin="0,0,6,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                        <Button Content="Older than 6 months" Tag="old files" Padding="10,6" Margin="0,0,6,0" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                        <Button Content="Photos" Tag="photos" Padding="10,6" Background="White" Foreground="#087D86" Click="Suggestion_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="AssistantStatus" Text="Suggestions use file size, dates, names, and local content hashes. They never decide a file is safe to remove." Foreground="#527078" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="#F7FAF9" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Ready · Select a folder to begin" TextWrapping="Wrap" Foreground="#245D62" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressText" Grid.Column="1" Foreground="#638287" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button x:Name="CancelScanButton" Grid.Column="2" Content="Cancel scan" IsEnabled="False" Background="Transparent" Foreground="#9B4D3B" Padding="8,4" Margin="8,0,0,0" Click="CancelScan_Click"/>
                    </Grid>
                    <ProgressBar x:Name="ScanProgress" Height="3" Margin="0,7,0,0" Foreground="#F37E69" Background="#C8E8E1" IsIndeterminate="False"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Background="White" CornerRadius="14" Padding="13">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="REVIEW FILES" Foreground="#143E50" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ReviewCountText" Grid.Column="1" Text="0 marked" Foreground="#688086" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Export list" Background="#E7F5F2" Foreground="#087D86" Padding="12,7" Margin="0,0,7,0" Click="Export_Click"/>
                            <Button x:Name="RecycleButton" IsEnabled="False" Grid.Column="3" Content="Move marked to Recycle Bin" Background="#FBECE7" Foreground="#9B4D3B" Padding="12,7" Click="RecycleMarked_Click"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Height="34" Padding="9,7" BorderBrush="#D6E6E5" ToolTip="Search file names and paths" TextChanged="SearchBox_TextChanged"/>
                            <ComboBox x:Name="SortBox" Grid.Column="1" Width="140" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged"><ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Oldest first"/></ComboBox>
                            <Button Grid.Column="2" Content="Mark visible" Background="Transparent" Foreground="#45616A" Padding="10,6" Click="MarkVisible_Click"/>
                            <Button Grid.Column="3" Content="Clear marks" Background="Transparent" Foreground="#45616A" Padding="10,6" Click="ClearMarks_Click"/>
                        </Grid>
                    </Grid>
                    <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionUnit="FullRow" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="REVIEW" Binding="{Binding Marked, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                            <DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="LOCATION" Binding="{Binding RelativePath}" Width="3*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeDisplay}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="MATCH" Binding="{Binding DuplicateDisplay}" Width="105" IsReadOnly="True"/>
                            <DataGridTextColumn Header="MODIFIED" Binding="{Binding ModifiedDisplay}" Width="145" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="5" Text="Local review · system/app files protected · cancel long scans · Recycle Bin recovery depends on PC settings" Foreground="#829498" FontSize="10" Margin="3,9,0,0"/>
        </Grid>
    </Grid>
</Window>
